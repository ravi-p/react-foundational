# ======================================
# Environment Variables Template
# ======================================
# Copy this file to .env.development, .env.uat, or .env.production
# and fill in the values for your environment.
#
# All variables MUST be prefixed with VITE_ to be accessible in the app.
# Access via: import.meta.env.VITE_VARIABLE_NAME
# ======================================

# API
VITE_API_BASE_URL=           # Base URL for API requests (e.g., http://localhost:8080/api)
VITE_API_TIMEOUT=30000       # Request timeout in milliseconds

# App
VITE_APP_NAME=               # Application name
VITE_APP_ENV=                # Environment: development | uat | production
